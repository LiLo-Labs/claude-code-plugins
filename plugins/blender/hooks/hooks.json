{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__(plugin_)?[^_]*blender[^_]*(_[^_]+)?__generate_mesh$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard_spend.py\"",
            "timeout": 15,
            "statusMessage": "Checking the generation against the session spend ceiling"
          }
        ]
      },
      {
        "matcher": "^mcp__(plugin_)?[^_]*blender[^_]*(_[^_]+)?__export_mesh$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard_export.py\"",
            "timeout": 15,
            "statusMessage": "Confirming the geometry was verified before export"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__(plugin_)?[^_]*blender[^_]*(_[^_]+)?__verify_geometry$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard_export.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
